{
  "server": {
    "address": "tcp://0.0.0.0:9091/"
  },
  "log": {
    "level": "info"
  },
  "totp": {
    "disable": false,
    "issuer": "Storage Backup",
    "algorithm": "SHA1",
    "digits": 6,
    "period": 30,
    "skew": 1
  },
  "webauthn": {
    "disable": true
  },
  "duo_api": {
    "disable": true
  },
  "authentication_backend": {
    "password_reset": {
      "disable": true
    },
    "file": {
      "path": "/users/users_database.yml",
      "watch": false
    }
  },
  "access_control": {
    "default_policy": "deny",
    "rules": [
      {
        "domain": [
          "files.storage.test",
          "console.storage.test"
        ],
        "subject": [
          "group:storage-admins"
        ],
        "policy": "two_factor"
      }
    ]
  },
  "session": {
    "name": "storage_session",
    "same_site": "lax",
    "inactivity": "5m",
    "expiration": "1h",
    "remember_me": "-1",
    "cookies": [
      {
        "domain": "storage.test",
        "authelia_url": "https://auth.storage.test",
        "default_redirection_url": "https://console.storage.test"
      }
    ]
  },
  "regulation": {
    "max_retries": 5,
    "find_time": "2m",
    "ban_time": "15m"
  },
  "storage": {
    "local": {
      "path": "/var/lib/authelia/db.sqlite3"
    }
  },
  "notifier": {
    "filesystem": {
      "filename": "/var/lib/authelia/notification.txt"
    }
  }
}
