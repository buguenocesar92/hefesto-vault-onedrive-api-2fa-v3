# Copiar a .env. Sin comillas ni expansión de shell.
MODE=lab
BASE_DOMAIN=storage.test
PORTAL_HOST=files.storage.test
AUTH_HOST=auth.storage.test
BIND_IP=127.0.0.1
HTTP_PORT=80
HTTPS_PORT=443
ADMIN_USER=admin
ADMIN_EMAIL=admin@example.com
# Para producción: MODE=production, DNS real, BIND_IP=0.0.0.0 y SMTP.
SMTP_ADDRESS=smtp://smtp.example.com:587
SMTP_USERNAME=change-me
SMTP_SENDER=Storage <storage@example.com>
# Latest solicitado; fijar todas las imágenes por digest después de validar.
RCLONE_IMAGE=rclone/rclone:latest
AUTHELIA_IMAGE=authelia/authelia:4.39
CADDY_IMAGE=caddy:2-alpine
FILEBROWSER_IMAGE=filebrowser/filebrowser:v2.30.0
# Secretos en secrets/*, nunca aquí. TOTP individual generado en Authelia.

# Réplica: 0 bloquea borrados; aumentar solo tras revisar dry-run.
MIRROR_MAX_DELETE=0

DASHBOARD_HOST=console.storage.test
API_HOST=api.storage.test
API_MAX_UPLOAD_BYTES=2147483648
