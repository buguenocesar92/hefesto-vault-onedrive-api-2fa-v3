# Config cifrado independiente para réplica.
RCLONE_CONFIG_PASS=GENERAR_Y_CONSERVAR
# Para app-only: mismas claves RCLONE_CONFIG_ONEDRIVE1_*, ONEDRIVE2_*
# y RCLONE_CONFIG_ONEDRIVE_BACKUP_* para el remoto onedrive_backup.
# Ejemplo (dotenv de Compose; NO ejecutar source):
